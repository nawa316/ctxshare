#!/usr/bin/env python3
"""Launcher for ctxshare. Works from a symlink in $HOME or $PREFIX/bin."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(here, "src"))

from ctxshare.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
